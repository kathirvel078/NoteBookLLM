# LocalLM Notebook Backend Configuration
APP_NAME=LocalLM Notebook
APP_ENV=development
LOG_LEVEL=INFO

# Ollama (100% local LLM inference)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_NUM_CTX=8192
OLLAMA_CHAT_TEMPERATURE=0.2
OLLAMA_STUDIO_TEMPERATURE=0.3
OLLAMA_TIMEOUT_SECONDS=120

# Local Embeddings (HuggingFace sentence-transformers)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_FALLBACK_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=32

# Storage paths (relative to project root or absolute)
DATA_DIR=../data

# RAG & Upload Limits
MAX_UPLOAD_MB=25
MAX_FILES_PER_UPLOAD=10
CHUNK_SIZE=900
CHUNK_OVERLAP=150
SEMANTIC_CHUNKING_ENABLED=false
RETRIEVAL_TOP_K=12
RETRIEVAL_KEEP_K=6
RETRIEVAL_MIN_SCORE=0.28
CHAT_HISTORY_MAX_TURNS=6
CHAT_CONTEXT_TOKEN_BUDGET=3200
CHAT_HISTORY_TOKEN_BUDGET=1200

# CORS
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Optional Piper TTS binary & voice models
PIPER_BIN=
PIPER_VOICE_A=
PIPER_VOICE_B=
